{
  "name": "nevrora-ventures-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Nevrora Ventures Platform Monorepo",
  "engines": {
    "node": "^20.0.0 || ^22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "turbo run build",
    "build:web": "pnpm --filter @nevrora/web build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  }
}
