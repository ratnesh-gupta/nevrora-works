{
  "name": "@nevrora/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.0.0 || ^22.0.0"
  },
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/api.test.ts test/adversarial.test.ts"
  },
  "dependencies": {
    "@nevrora/config": "workspace:*",
    "@nevrora/types": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.24",
    "@types/supertest": "^6.0.2",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2"
  }
}
